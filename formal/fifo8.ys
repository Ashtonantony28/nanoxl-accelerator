# yosys script: elaborate the FORMAL properties of the module into an SMT2 model
# (paths relative to formal/; run every proof with: python3 formal/run_formal.py)
read_verilog -formal -sv ../rtl/fifo_sync.sv
chparam -set W 3 -set DEPTH 8 fifo_sync
prep -top fifo_sync
async2sync
dffunmap
write_smt2 -wires fifo8.smt2
